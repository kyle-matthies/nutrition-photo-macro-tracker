# Required for live photo analysis. Keep this server-side/local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional: clearly labeled deterministic demo mode for local UI exploration.
MACRO_LENS_DEMO=0

# Optional Supabase cloud history. Use a publishable key, never a secret/service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local SQLite path. The data directory is gitignored.
MACRO_LENS_DB_PATH=data/macro_lens.sqlite
